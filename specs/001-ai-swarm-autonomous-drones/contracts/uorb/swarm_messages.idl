module swarm {
    // Formation control setpoint (leader -> followers)
    struct swarm_formation_set_s {
        uint64 timestamp_us;
        uint16 leader_id;
        uint32 formation_id;
        uint8 geometry_type;           // 0=LINE, 1=VEE, 2=DIAMOND, 3=COLUMN, 4=CUSTOM
        float32[3] relative_positions[50]; // FLU frame, max 50 followers
        float32 spacing_m;
        float32 altitude_offset_m;
        float32 heading_offset_deg;
        float32 max_lateral_error_m;
        float32 max_vertical_error_m;
        float32 max_velocity_error_mps;
        float32 max_yaw_error_deg;
        float32 rejoin_timeout_s;
        float32 replan_propagation_ms;
        uint16 follower_ids[50];
        float32[3] offsets_flu[50];
        float32 gains_xy[50];
        float32 gains_z[50];
        float32 gains_yaw[50];
        uint32 sequence;
    };

    // Formation state report (follower -> leader)
    struct swarm_formation_state_s {
        uint64 timestamp_us;
        uint16 follower_id;
        uint32 formation_id;
        float32[3] position_error_flu;
        float32[3] velocity_error_flu;
        float32 yaw_error_deg;
        uint8 status;                  // 0=FORMING, 1=HOLDING, 2=REJOINING, 3=LOST
        uint32 sequence;
    };

    // Task allocation bid (drone -> swarm)
    struct swarm_task_bid_s {
        uint64 timestamp_us;
        uint16 drone_id;
        uint8[16] task_id;             // UUID
        float32 cost;
        bool has_rtk_gps;
        bool has_stereo_camera;
        bool has_lidar_2d;
        bool has_lidar_3d;
        bool has_uwb;
        bool has_5g_modem;
        bool has_ai_compute;
        uint16 max_flight_time_s;
        float32 max_payload_kg;
        uint8 comm_tier_bitmap;
        uint32 sequence;
    };

    // Task allocation award (swarm -> drone)
    struct swarm_task_award_s {
        uint64 timestamp_us;
        uint16 drone_id;
        uint8[16] task_id;
        uint32 award_sequence;
        float32 awarded_cost;
        uint32 sequence;
    };

    // AI inference report
    struct swarm_ai_inference_s {
        uint64 timestamp_us;
        uint16 drone_id;
        uint8 type;                    // 0=OBSTACLE, 1=LANDING, 2=FAULT, 3=ANOMALY
        uint16 class_id;
        char class_name[32];
        float32 confidence;
        float32[3] position_enu;
        float32[3] bbox_size;
        float32[4] bbox_orientation;   // quaternion w,x,y,z
        uint32 latency_ms;
        char model_name[32];
        char model_version[16];
        char runtime[16];              // "tensorrt_fp16"
        // Obstacle meta
        uint8 threat_level;            // 0=LOW, 1=MED, 2=HIGH, 3=CRITICAL
        float32[3] relative_velocity;
        float32 time_to_collision_s;
        bool requires_immediate_avoidance;
        // Landing meta
        float32 slope_deg;
        float32 clearance_radius_m;
        uint8 surface_type;
        float32 firmness_score;
        // Fault meta
        uint8 fault_type;
        uint8 severity;
        char affected_component[32];
        float32 degradation_pct;
        bool requires_replan;
        uint8 recommended_action;
    };

    // Safety event
    struct swarm_safety_event_s {
        uint64 timestamp_us;
        uint16 source_id;
        uint8 type;                    // 0=GEOFENCE, 1=ESTOP, 2=RID, 3=FAULT, 4=COMMS, 5=LEADER_FAIL
        uint8 severity;                // 0=INFO, 1=WARN, 2=CRIT, 3=EMERG
        float32[3] position_enu;
        char details[128];
        uint32 sequence;
    };

    // Human intent command
    struct swarm_human_intent_s {
        uint64 timestamp_us;
        uint16 target_id;              // 0 = broadcast
        uint8 type;                    // 0=SEARCH, 1=FOLLOW, 2=INSPECT, 3=RTL, 4=HOLD, 5=ESTOP, 6=FORMATION, 7=ABORT
        char params_json[512];         // JSON parameters
        uint8 priority;
        uint32 sequence;
    };

    // Communication QoS
    struct swarm_comm_qos_s {
        uint64 timestamp_us;
        uint16 src_id;
        uint16 dst_id;
        uint8 link_type;               // 0=WIFI6E, 1=5G, 2=LORA, 3=MAVLINK
        float32 latency_ms_p50;
        float32 latency_ms_p99;
        float32 packet_loss_pct;
        float32 bandwidth_mbps;
        float32 rssi_dbm;
        float32 snr_db;
        uint32 tx_bytes;
        uint32 rx_bytes;
        uint32 tx_errors;
        uint32 rx_errors;
        uint16 route[10];              // Multi-hop path
        uint8 status;                  // 0=UP, 1=DEGRADED, 2=DOWN, 3=STORE_FORWARD
        uint32 sequence;
    };
}