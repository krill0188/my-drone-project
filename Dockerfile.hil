# Dockerfile for HIL (Hardware-in-the-Loop)

FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# Install dependencies for HIL
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget curl lsb-release gnupg2 \
    python3 python3-pip python3-venv python3-dev \
    build-essential cmake ninja-build \
    libeigen3-dev libopencv-dev \
    ros-humble-desktop-full \
    ros-humble-mavros ros-humble-mavros-extras \
    ros-humble-rosbag2 ros-humble-rosbag2-storage \
    ros-humble-cv-bridge ros-humble-image-transport \
    ros-humble-serial-driver \
    screen minicom picocom \
    udev usbutils \
    && rm -rf /var/lib/apt/lists/*

# Setup ROS 2
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

# Create workspace
WORKDIR /workspace
RUN mkdir -p src

# Copy source
COPY . /workspace/

# Build ROS 2 workspace
RUN cd /workspace/src/companion && \
    /opt/ros/humble/setup.bash && \
    colcon build --symlink-install 2>&1 | tail -20

# Configure udev rules for Pixhawk/Cube
RUN echo 'SUBSYSTEM=="tty", ATTRS{idVendor}=="26ac", ATTRS{idProduct}=="0011", MODE="0666", GROUP="dialout", SYMLINK+="px4"' > /etc/udev/rules.d/99-px4.rules && \
    echo 'SUBSYSTEM=="tty", ATTRS{idVendor}=="26ac", ATTRS{idProduct}=="0013", MODE="0666", GROUP="dialout", SYMLINK+="cube"' >> /etc/udev/rules.d/99-px4.rules && \
    echo 'SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="606f", MODE="0666", GROUP="dialout", SYMLINK+="cuav"' >> /etc/udev/rules.d/99-px4.rules

# Entry point
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["bash"]